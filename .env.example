# Neon Postgres (Vercel Marketplace -> Neon)
DATABASE_URL=postgresql://...

# Vercel Blob
# New Vercel Blob stores can authenticate with Vercel OIDC automatically.
# If your store uses a read/write token instead, Vercel injects it here.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Independent admin login (ChatGPT/OpenAI hesabıyla ilişkili değildir)
ADMIN_USERNAME=yonetici
ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_PASSWORD_12PLUS
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Public canonical address
NEXT_PUBLIC_APP_URL=https://ppwr.acilimkutu.com
